# ==============================================================================
# INSIGHT CIRCLE PALACE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as .env locally or set these environment variables in your
# hosting provider dashboard (e.g., Vercel, Supabase, Railway, Render).

# Application Environment ('production' or 'development')
APP_ENV=production

# Public Base URL (Must match your live domain, with https:// and no trailing slash)
BASE_URL=https://insightcirclepalace.org

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In local development: defaults to sqlite+aiosqlite:///./insight_circle.db
# In production (e.g. Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL=postgresql+asyncpg://postgres.yourproject:YourPassword@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./insight_circle.db

# ------------------------------------------------------------------------------
# EMAIL DELIVERY (Resend / SMTP)
# ------------------------------------------------------------------------------
# Resend API Key for account verification, password resets, and certificate delivery.
# Sign up at https://resend.com and generate an API key starting with 're_'
RESEND_API_KEY=re_your_api_key_here

# Sender Email:
# Before domain verification in Resend, use: "Insight Circle Palace <onboarding@resend.dev>"
# After verifying your domain in Resend DNS, use: "Insight Circle Palace <notifications@insightcirclepalace.org>"
EMAIL_FROM=Insight Circle Palace <onboarding@resend.dev>

# Reply-To address shown to users
EMAIL_REPLY_TO=Insightcirclepalace@gmail.com

# Administrative notification recipient
ADMIN_EMAIL=Insightcirclepalace@gmail.com

# Optional SMTP fallback (used only if RESEND_API_KEY is not provided):
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=Insightcirclepalace@gmail.com
# SMTP_PASSWORD=your_app_password

# ------------------------------------------------------------------------------
# GOOGLE OAUTH AUTHENTICATION (Optional)
# ------------------------------------------------------------------------------
# Configure in Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# Add your custom domain to Authorized JavaScript Origins and Redirect URIs.
GOOGLE_CLIENT_ID=326628685130-e65tfg5ldhpj8vhje2ucufv9q95d8t19.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CORS ALLOWED ORIGINS (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Defaults already cover insightcirclepalace.org, insightcirclepalace.com, and vercel.
CORS_ORIGINS=https://insightcirclepalace.org,https://www.insightcirclepalace.org,https://insightcirclepalace.com,https://www.insightcirclepalace.com,https://admin.insight-circle-palace.vercel.app,https://insight-circle-palace.vercel.app
