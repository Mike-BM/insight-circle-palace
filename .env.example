# ==============================================================================
# INSIGHT CIRCLE PALACE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as .env locally or set these environment variables in your
# hosting provider dashboard (e.g., Vercel, Supabase, Railway, Render).

# Application Environment ('production' or 'development')
APP_ENV=production

# Public Base URL (Must match your live domain, with https:// and no trailing slash)
BASE_URL=https://insightcirclepalace.com

# ------------------------------------------------------------------------------
# SECURITY (read me)
# ------------------------------------------------------------------------------
# There is NO default admin password. Bootstrap super_admin accounts are only created on
# startup when this is set (12+ chars); they must change it at first login. Remove it from
# your environment after the first successful login.
# ADMIN_INITIAL_PASSWORD=
#
# Shared secret appended to the M-Pesa callback URL (?token=...). Generate a long random
# value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# MPESA_CALLBACK_TOKEN=
#
# Shared store for rate limiting (serverless instances otherwise count separately).
# Free Upstash Redis works well:  rediss://default:<password>@<host>:6379
# RATE_LIMIT_STORAGE_URI=

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In local development: defaults to sqlite+aiosqlite:///./insight_circle.db
# In production (e.g. Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL=postgresql+asyncpg://postgres.yourproject:YourPassword@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./insight_circle.db

# ------------------------------------------------------------------------------
# SUPABASE STORAGE & OBJECT SIGNING (Optional for private recording buckets)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# SUPABASE_RECORDINGS_BUCKET=recordings

# ------------------------------------------------------------------------------
# EMAIL DELIVERY (Resend / SMTP)
# ------------------------------------------------------------------------------
# Resend API Key for account verification, password resets, and certificate delivery.
# Sign up at https://resend.com and generate an API key starting with 're_'
RESEND_API_KEY=re_your_api_key_here

# Sender Email:
# Verified custom domain:
EMAIL_FROM=Insight Circle Palace <notifications@insightcirclepalace.com>

# Reply-To address shown to users
EMAIL_REPLY_TO=Insightcirclepalace@gmail.com

# Administrative notification recipient
ADMIN_EMAIL=Insightcirclepalace@gmail.com

# Optional SMTP fallback (used only if RESEND_API_KEY is not provided):
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=Insightcirclepalace@gmail.com
# SMTP_PASSWORD=your_app_password

# ------------------------------------------------------------------------------
# GOOGLE OAUTH AUTHENTICATION (Optional)
# ------------------------------------------------------------------------------
# Configure in Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# Add your custom domain to Authorized JavaScript Origins and Redirect URIs.
GOOGLE_CLIENT_ID=326628685130-e65tfg5ldhpj8vhje2ucufv9q95d8t19.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CORS ALLOWED ORIGINS (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Defaults already cover insightcirclepalace.org, insightcirclepalace.com, and vercel.
CORS_ORIGINS=https://insightcirclepalace.org,https://www.insightcirclepalace.org,https://insightcirclepalace.com,https://www.insightcirclepalace.com,https://admin.insight-circle-palace.vercel.app,https://insight-circle-palace.vercel.app

# ------------------------------------------------------------------------------
# M-PESA DARAJA PAYMENT CONFIGURATION (Kenyan Shillings / STK Push)
# ------------------------------------------------------------------------------
# Mode: 'sandbox' for testing, 'production' for live Safaricom Daraja API
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
# Business Shortcode (e.g. 174379 for Daraja Sandbox or your live Paybill/Till)
MPESA_SHORTCODE=174379
# Passkey from Daraja developer portal (the value below is the PUBLIC sandbox passkey)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public HTTPS URL reachable by Safaricom servers (the MPESA_CALLBACK_TOKEN is added automatically)
MPESA_CALLBACK_URL=https://insightcirclepalace.com/api/payments/mpesa/callback

# ------------------------------------------------------------------------------
# STRIPE PAYMENT CONFIGURATION (USD / International Credit & Debit Cards)
# ------------------------------------------------------------------------------
# Stripe Secret Key (starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Stripe Publishable Key for frontend elements (starts with pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Stripe Webhook Signing Secret (starts with whsec_...). REQUIRED in production: without it
# the webhook endpoint refuses all events.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Pricing & Exchange Rates
STRIPE_MEMBERSHIP_PRICE_USD=2.50
KES_TO_USD_RATE=130.0
