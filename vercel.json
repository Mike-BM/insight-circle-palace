{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin_app/**",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin_app/login.html",
      "permanent": false
    },
    {
      "source": "/admin_app",
      "destination": "/admin_app/login.html",
      "permanent": false
    },
    {
      "source": "/admin_app/",
      "destination": "/admin_app/login.html",
      "permanent": false
    },
    {
      "source": "/admin_app/index.html",
      "destination": "/admin_app/login.html",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/admin/dashboard/stats",
      "dest": "/main.py"
    },
    {
      "src": "/admin/login",
      "dest": "/admin_app/login.html"
    },
    {
      "src": "/admin/dashboard",
      "dest": "/admin_app/dashboard.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/admin_app/(.*)",
      "dest": "/admin_app/$1"
    },
    {
      "src": "/",
      "dest": "/static/index.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/static/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/static/sitemap.xml"
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/assets/favicon-32x32.png"
    },
    {
      "src": "/explore",
      "dest": "/static/explore.html"
    },
    {
      "src": "/events",
      "dest": "/static/events.html"
    },
    {
      "src": "/events.html",
      "dest": "/static/events.html"
    },
    {
      "src": "/join",
      "dest": "/static/join.html"
    },
    {
      "src": "/login",
      "dest": "/static/login.html"
    },
    {
      "src": "/register",
      "dest": "/static/register.html"
    },
    {
      "src": "/onboard",
      "dest": "/static/onboard.html"
    },
    {
      "src": "/dashboard",
      "dest": "/static/dashboard.html"
    },
    {
      "src": "/profile",
      "dest": "/static/profile.html"
    },
    {
      "src": "/my-events",
      "dest": "/static/my-events.html"
    },
    {
      "src": "/my-programs",
      "dest": "/static/my-programs.html"
    },
    {
      "src": "/certificates",
      "dest": "/static/certificates.html"
    },
    {
      "src": "/verify",
      "dest": "/static/verify.html"
    },
    {
      "src": "/reset-password",
      "dest": "/static/reset-password.html"
    },
    {
      "src": "/feedback",
      "dest": "/static/feedback.html"
    },
    {
      "src": "/learn",
      "dest": "/static/learn.html"
    },
    {
      "src": "/learn.html",
      "dest": "/static/learn.html"
    },
    {
      "src": "/assignments",
      "dest": "/static/assignments.html"
    },
    {
      "src": "/assignments.html",
      "dest": "/static/assignments.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/static/privacy-policy.html"
    },
    {
      "src": "/terms-and-conditions",
      "dest": "/static/terms-and-conditions.html"
    },
    {
      "src": "/terms",
      "dest": "/static/terms-and-conditions.html"
    },
    {
      "src": "/maintenance",
      "dest": "/static/maintenance.html"
    },
    {
      "src": "/tech-ai",
      "dest": "/static/tech-ai.html"
    },
    {
      "src": "/leadership",
      "dest": "/static/leadership.html"
    },
    {
      "src": "/finance",
      "dest": "/static/finance.html"
    },
    {
      "src": "/entrepreneurship",
      "dest": "/static/entrepreneurship.html"
    },
    {
      "src": "/research",
      "dest": "/static/research.html"
    },
    {
      "src": "/wellness",
      "dest": "/static/wellness.html"
    },
    {
      "src": "/relationships",
      "dest": "/static/relationships.html"
    },
    {
      "src": "/healing",
      "dest": "/static/healing.html"
    },
    {
      "src": "/ai-strategy-executive",
      "dest": "/static/ai-strategy-executive.html"
    },
    {
      "src": "/([^/]+)\\.html",
      "dest": "/static/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/main.py"
    }
  ]
}